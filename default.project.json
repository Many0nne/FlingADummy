{
  "name": "FlingADummy",
  "servePort": 34900,
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 60
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Players": {
      "$properties": {
        "MaxPlayers": 4
      }
    },

    "Lighting": {
      "$properties": {
        "ClockTime": 14.5,
        "Brightness": 3,
        "GlobalShadows": true
      }
    },

    "MaterialService": {
      "FadChecker": {
        "$path": "src/materials/FadChecker.model.json"
      },
      "FadWall": {
        "$path": "src/materials/FadWall.model.json"
      },
      "FadBrick": {
        "$path": "src/materials/FadBrick.model.json"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
