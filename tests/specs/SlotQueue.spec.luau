-- Attribution des places du lobby et file d'attente (#142).
return function(T, Loader)
	local SlotQueue = Loader.new():require("src/shared/SlotQueue")

	-- Cette méthode permet de remplir un lobby de `count` places avec les joueurs "p1" à "p<n>" lorsqu'un test commence.
	local function filled(count: number, players: number)
		local queue = SlotQueue.new(count)
		for i = 1, players do
			queue:join("p" .. i)
		end
		return queue
	end

	T.describe("SlotQueue.join", function()
		T.it("donne les places dans l'ordre d'arrivée", function()
			local queue = SlotQueue.new(4)
			T.expectEqual(queue:join("a"), 1)
			T.expectEqual(queue:join("b"), 2)
			T.expectEqual(queue:join("c"), 3)
		end)
		T.it("lobby plein : le joueur attend, sans place", function()
			local queue = filled(4, 4)
			T.expectEqual(queue:join("p5"), nil)
			T.expectEqual(queue:isWaiting("p5"), true)
			T.expectEqual(queue:isWaiting("p1"), false)
		end)
		T.it("rejouer l'arrivée ne change rien", function()
			local queue = filled(2, 3)
			T.expectEqual(queue:join("p1"), 1)
			T.expectEqual(queue:join("p3"), nil)
			T.expectEqual(#queue.waiting, 1)
		end)
	end)

	T.describe("SlotQueue.leave", function()
		T.it("la place libérée va au plus ancien joueur en attente", function()
			local queue = filled(4, 6) -- p5 puis p6 attendent
			local next, index = queue:leave("p2")
			T.expectEqual(next, "p5")
			T.expectEqual(index, 2)
			T.expectEqual(queue:isWaiting("p5"), false)
			T.expectEqual(queue:isWaiting("p6"), true)
		end)
		T.it("plusieurs départs : les attentes passent dans l'ordre d'arrivée", function()
			local queue = filled(2, 5) -- p3, p4, p5 attendent
			local first, firstIndex = queue:leave("p1")
			local second, secondIndex = queue:leave("p2")
			local third = queue:leave("p3") -- p3 a repris la place 1 : p5 la reçoit à son tour
			T.expectEqual(first, "p3")
			T.expectEqual(firstIndex, 1)
			T.expectEqual(second, "p4")
			T.expectEqual(secondIndex, 2)
			T.expectEqual(third, "p5")
			T.expectEqual(queue:isWaiting("p5"), false)
		end)
		T.it("le joueur promu libère à son tour sa place pour le suivant", function()
			local queue = filled(1, 3)
			T.expectEqual((queue:leave("p1")), "p2")
			T.expectEqual((queue:leave("p2")), "p3")
			T.expectEqual(queue.slotOf.p3, 1)
		end)
		T.it("personne n'attend : la place redevient libre", function()
			local queue = filled(4, 2)
			local next = queue:leave("p1")
			T.expectEqual(next, nil)
			T.expectEqual(queue:isFree(1), true)
			T.expectEqual(queue:join("z"), 1)
		end)
		T.it("un joueur en attente qui part quitte la file sans toucher aux places", function()
			local queue = filled(1, 3) -- p2, p3 attendent
			T.expectEqual((queue:leave("p2")), nil)
			T.expectEqual(queue:isWaiting("p2"), false)
			T.expectEqual((queue:leave("p1")), "p3")
		end)
		T.it("un joueur inconnu ne change rien", function()
			local queue = filled(2, 2)
			T.expectEqual((queue:leave("ghost")), nil)
			T.expectEqual(queue:isFree(1), false)
		end)
	end)
end
