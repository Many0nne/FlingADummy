-- Superposition du haut de l'écran : fenêtres, bandeau, popups, offre « NEW GEAR! » et texte de l'objectif (#87, #62).
return function(T, Loader)
	local Overlay = Loader.new():require("src/shared/Overlay")

	T.describe("Overlay.offer", function()
		T.it("écran libre : l'offre s'affiche", function()
			T.expectEqual(Overlay.offer({ windowOpen = false }), true)
		end)
		T.it("une fenêtre ouverte (vente, My Dummies, Index, boutiques) masque l'offre", function()
			T.expectEqual(Overlay.offer({ windowOpen = true }), false)
		end)
		T.it("le bandeau d'annonce, à la même place, masque l'offre", function()
			T.expectEqual(Overlay.offer({ windowOpen = false, bannerShown = true }), false)
		end)
		T.it("un popup de palier (LEVEL UP! à chaque niveau d'entraînement) laisse l'offre cliquable", function()
			T.expectEqual(Overlay.offer({ windowOpen = false, popupShown = true }), true)
		end)
	end)

	T.describe("Overlay.objective", function()
		T.it("écran libre : le texte de l'objectif est en haut au centre", function()
			T.expectEqual(Overlay.objective({ windowOpen = false }), "Top")
		end)
		T.it("le popup d'offre fait passer le texte sous lui (il était dessiné sur son bandeau, #62)", function()
			T.expectEqual(Overlay.objective({ windowOpen = false, offerShown = true }), "BelowOffer")
		end)
		T.it("une fenêtre, le bandeau ou un popup de palier masquent le texte", function()
			T.expectEqual(Overlay.objective({ windowOpen = true }), "Hidden")
			T.expectEqual(Overlay.objective({ windowOpen = false, bannerShown = true }), "Hidden")
			T.expectEqual(Overlay.objective({ windowOpen = false, popupShown = true, offerShown = true }), "Hidden")
		end)
		T.it("tout revient à la fermeture : la règle ne dépend que de l'état courant", function()
			local state: any = { windowOpen = true }
			T.expectEqual(Overlay.offer(state), false)
			T.expectEqual(Overlay.objective(state), "Hidden")
			state.windowOpen = false
			state.offerShown = Overlay.offer(state)
			T.expectEqual(state.offerShown, true)
			T.expectEqual(Overlay.objective(state), "BelowOffer")
		end)
	end)
end
