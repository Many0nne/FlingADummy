-- Économie : vitesse selon la Throw Power, valeur du mannequin, gains d'un lancer.
return function(T, Loader)
	local loader = Loader.new()
	local Economy = loader:require("src/shared/Economy")
	local GameConfig = loader:require("src/shared/GameConfig")

	T.describe("Economy.launchSpeed", function()
		T.it("vaut la vitesse de base à la puissance de départ (et en dessous)", function()
			T.expectNear(Economy.launchSpeed(GameConfig.START_POWER), GameConfig.SPEED_BASE)
			T.expectNear(Economy.launchSpeed(0), GameConfig.SPEED_BASE)
		end)
		T.it("gagne SPEED_PER_LOG à chaque facteur e de puissance", function()
			local power = GameConfig.START_POWER * math.exp(2)
			T.expectNear(Economy.launchSpeed(power), GameConfig.SPEED_BASE + 2 * GameConfig.SPEED_PER_LOG, 1e-6)
		end)
		T.it("croît de moins en moins vite : ×10 de puissance donne le même gain partout", function()
			local a = Economy.launchSpeed(100) - Economy.launchSpeed(10)
			local b = Economy.launchSpeed(100000) - Economy.launchSpeed(10000)
			T.expectNear(a, b, 1e-6)
		end)
	end)

	T.describe("Economy.valueCost", function()
		T.it("démarre au prix de base, croît, nil au maximum", function()
			T.expectEqual(Economy.valueCost(1), GameConfig.VALUE_BASE_COST)
			T.expect((Economy.valueCost(2) :: number) > GameConfig.VALUE_BASE_COST, "prix croissant")
			T.expectEqual(Economy.valueCost(GameConfig.VALUE_MAX_LEVEL), nil)
		end)
	end)

	T.describe("Economy.payout", function()
		T.it("additionne distance, os et objets sans multiplicateur", function()
			local p =
				Economy.payout({ distance = 123.7, bones = 4, smashed = 3, perfect = false, zoneMultiplier = 1 }, 1)
			T.expectEqual(p.distance, 123)
			T.expectEqual(p.bonesMoney, 40)
			T.expectEqual(p.smashMoney, 15)
			T.expectEqual(p.total, 178)
		end)
		T.it("multiplie zone, valeur et PERFECT, arrondi", function()
			local p = Economy.payout({ distance = 100, bones = 0, smashed = 1, perfect = true, zoneMultiplier = 2 }, 2)
			-- (100 + 5) × 2 × 1,25 × 1,2 = 315
			T.expectEqual(p.total, 315)
			T.expectNear(p.valueMultiplier, 1.25)
		end)
		T.it("ne compte pas de distance négative", function()
			local p = Economy.payout({ distance = -5, bones = 0, smashed = 0, perfect = false, zoneMultiplier = 1 }, 1)
			T.expectEqual(p.total, 0)
		end)
	end)
end
