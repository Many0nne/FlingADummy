-- UIMotion : courbes d'échelle des pops, flottement / pulsation de la flèche, pastille rouge, regroupement des « +N ».
return function(T, Loader)
	local UIMotion = Loader.new():require("src/shared/UIMotion")

	T.describe("UIMotion.sample", function()
		T.it("fenêtre : 0,6 → 1,05 → 1 en 0,25 s", function()
			local keys = UIMotion.WINDOW_OPEN
			T.expectNear(UIMotion.sample(keys, 0), 0.6)
			T.expectNear(UIMotion.sample(keys, 0.16), 1.05)
			T.expectNear(UIMotion.sample(keys, 0.25), 1)
			T.expectNear(UIMotion.duration(keys), 0.25)
		end)
		T.it("borne avant le début et après la fin", function()
			T.expectNear(UIMotion.sample(UIMotion.WINDOW_OPEN, -1), 0.6)
			T.expectNear(UIMotion.sample(UIMotion.WINDOW_OPEN, 5), 1)
		end)
		T.it("ne dépasse jamais le pic de 1,05 (pas de rebond parasite)", function()
			local peak = 0
			for i = 0, 100 do
				peak = math.max(peak, UIMotion.sample(UIMotion.WINDOW_OPEN, i * 0.0025))
			end
			T.expectNear(peak, 1.05, 1e-6)
		end)
		T.it("fermeture rapide (≈ 0,12 s) et rebonds des popups / compteurs qui finissent à 1", function()
			T.expectNear(UIMotion.duration(UIMotion.WINDOW_CLOSE), 0.12)
			for _, keys in { UIMotion.WINDOW_OPEN, UIMotion.POPUP_IN, UIMotion.COUNTER_BUMP } do
				T.expectNear(keys[#keys].scale, 1)
			end
		end)
		T.it("étapes en temps croissant", function()
			for _, keys in { UIMotion.WINDOW_OPEN, UIMotion.WINDOW_CLOSE, UIMotion.POPUP_IN, UIMotion.COUNTER_BUMP } do
				for i = 2, #keys do
					T.expect(keys[i].time > keys[i - 1].time, "temps non croissant")
				end
			end
		end)
	end)

	T.describe("UIMotion.float / pulse", function()
		T.it("flottement entre -1 et 1, nul en mouvement réduit", function()
			for i = 0, 50 do
				local v = UIMotion.float(i * 0.13)
				T.expect(v >= -1 and v <= 1, "hors bornes")
				T.expectEqual(UIMotion.float(i * 0.13, true), 0)
			end
		end)
		T.it("pulsation entre 1 et 1 + amplitude, périodique, 1 en mouvement réduit", function()
			local P = UIMotion.PULSE_PERIOD
			T.expectNear(UIMotion.pulse(0), 1)
			T.expectNear(UIMotion.pulse(P / 2), 1 + UIMotion.PULSE_AMPLITUDE)
			T.expectNear(UIMotion.pulse(3 * P + 0.2), UIMotion.pulse(0.2), 1e-6)
			T.expectEqual(UIMotion.pulse(P / 2, true), 1)
		end)
	end)

	T.describe("UIMotion.badgeText", function()
		T.it("masque pour nil, 0 ou négatif, et pour un texte vide", function()
			T.expectEqual(UIMotion.badgeText(nil), nil)
			T.expectEqual(UIMotion.badgeText(0), nil)
			T.expectEqual(UIMotion.badgeText(-2), nil)
			T.expectEqual(UIMotion.badgeText(""), nil)
		end)
		T.it("affiche le nombre, plafonné à 99+, ou le texte libre", function()
			T.expectEqual(UIMotion.badgeText(1), "1")
			T.expectEqual(UIMotion.badgeText(99), "99")
			T.expectEqual(UIMotion.badgeText(100), "99+")
			T.expectEqual(UIMotion.badgeText("!"), "!")
		end)
	end)

	T.describe("UIMotion.push", function()
		T.it("regroupe les gains rapprochés dans la même étiquette", function()
			local batch = UIMotion.newBatch(0.3, 0.9, 3)
			local kind, id, total = UIMotion.push(batch, 5, 0)
			T.expectEqual(kind, "spawn")
			T.expectEqual(total, 5)
			local kind2, id2, total2 = UIMotion.push(batch, 7, 0.1)
			T.expectEqual(kind2, "merge")
			T.expectEqual(id2, id)
			T.expectEqual(total2, 12)
		end)
		T.it("ouvre une nouvelle étiquette quand les gains sont espacés", function()
			local batch = UIMotion.newBatch(0.3, 0.9, 3)
			local _, first = UIMotion.push(batch, 5, 0)
			local kind, second = UIMotion.push(batch, 5, 0.5)
			T.expectEqual(kind, "spawn")
			T.expect(second ~= first, "même étiquette")
		end)
		T.it("jamais plus de maxLabels étiquettes en vol", function()
			local batch = UIMotion.newBatch(0.1, 2, 2)
			UIMotion.push(batch, 1, 0)
			local _, second = UIMotion.push(batch, 1, 0.2)
			local kind, id, total = UIMotion.push(batch, 1, 0.4)
			T.expectEqual(kind, "merge")
			T.expectEqual(id, second)
			T.expectEqual(total, 2)
		end)
		T.it("oublie les étiquettes arrivées", function()
			local batch = UIMotion.newBatch(0.1, 0.5, 1)
			UIMotion.push(batch, 1, 0)
			local kind = UIMotion.push(batch, 1, 0.6)
			T.expectEqual(kind, "spawn")
			T.expectEqual(#batch.flights, 1)
		end)
	end)

	T.describe("UIMotion.burstSize", function()
		T.it("3 à 6 icônes selon le gain, aucune sans gain", function()
			T.expectEqual(UIMotion.burstSize(0), 0)
			T.expectEqual(UIMotion.burstSize(1), 3)
			T.expectEqual(UIMotion.burstSize(1000), 5)
			T.expectEqual(UIMotion.burstSize(1e9), 6)
		end)
	end)
end
