-- Format : séparateurs de milliers, abréviations K / M, argent, mètres.
return function(T, Loader)
	local Format = Loader.new():require("src/shared/Format")

	T.describe("Format.thousands", function()
		T.it("sépare les milliers", function()
			T.expectEqual(Format.thousands(0), "0")
			T.expectEqual(Format.thousands(999), "999")
			T.expectEqual(Format.thousands(1000), "1,000")
			T.expectEqual(Format.thousands(1234567), "1,234,567")
			T.expectEqual(Format.thousands(-1500), "-1,500")
		end)
	end)

	T.describe("Format.short", function()
		T.it("garde les petits nombres entiers", function()
			T.expectEqual(Format.short(0), "0")
			T.expectEqual(Format.short(999.9), "999")
		end)
		T.it("abrège avec 3 chiffres significatifs, sans zéros inutiles", function()
			T.expectEqual(Format.short(1000), "1K")
			T.expectEqual(Format.short(1234), "1.23K")
			T.expectEqual(Format.short(12345), "12.3K")
			T.expectEqual(Format.short(92300), "92.3K")
			T.expectEqual(Format.short(123456), "123K")
			T.expectEqual(Format.short(3750000), "3.75M")
			T.expectEqual(Format.short(2e9), "2B")
		end)
		T.it("tronque au lieu d'arrondir", function()
			T.expectEqual(Format.short(999999), "999K")
			T.expectEqual(Format.short(1999), "1.99K")
		end)
		T.it("gère le négatif", function()
			T.expectEqual(Format.short(-1500), "-1.5K")
		end)
	end)

	T.describe("Format.money / meters", function()
		T.it("préfixe le dollar", function()
			T.expectEqual(Format.money(0), "$0")
			T.expectEqual(Format.money(12345), "$12.3K")
			T.expectEqual(Format.money(-1500), "-$1.5K")
		end)
		T.it("arrondit au mètre inférieur, jamais négatif", function()
			T.expectEqual(Format.meters(123.8), "123 m")
			T.expectEqual(Format.meters(1500), "1,500 m")
			T.expectEqual(Format.meters(-3), "0 m")
		end)
	end)
end
