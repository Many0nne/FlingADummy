-- Format : séparateurs de milliers, abréviations K / M, argent, revenu par seconde, mètres, CHANCE en X.
return function(T, Loader)
	local Format = Loader.new():require("src/shared/Format")

	T.describe("Format.thousands", function()
		T.it("sépare les milliers", function()
			T.expectEqual(Format.thousands(0), "0")
			T.expectEqual(Format.thousands(999), "999")
			T.expectEqual(Format.thousands(1000), "1,000")
			T.expectEqual(Format.thousands(1234567), "1,234,567")
			T.expectEqual(Format.thousands(-1500), "-1,500")
		end)
	end)

	T.describe("Format.short", function()
		T.it("garde les petits nombres entiers", function()
			T.expectEqual(Format.short(0), "0")
			T.expectEqual(Format.short(999.9), "999")
		end)
		T.it("abrège avec 3 chiffres significatifs, sans zéros inutiles", function()
			T.expectEqual(Format.short(1000), "1K")
			T.expectEqual(Format.short(1234), "1.23K")
			T.expectEqual(Format.short(12345), "12.3K")
			T.expectEqual(Format.short(92300), "92.3K")
			T.expectEqual(Format.short(123456), "123K")
			T.expectEqual(Format.short(3750000), "3.75M")
			T.expectEqual(Format.short(2e9), "2B")
		end)
		T.it("tronque au lieu d'arrondir", function()
			T.expectEqual(Format.short(999999), "999K")
			T.expectEqual(Format.short(1999), "1.99K")
		end)
		T.it("gère le négatif", function()
			T.expectEqual(Format.short(-1500), "-1.5K")
		end)
	end)

	T.describe("Format.money / meters", function()
		T.it("préfixe le dollar", function()
			T.expectEqual(Format.money(0), "$0")
			T.expectEqual(Format.money(12345), "$12.3K")
			T.expectEqual(Format.money(-1500), "-$1.5K")
		end)
		T.it("écrit le revenu par seconde, jamais négatif", function()
			T.expectEqual(Format.perSecond(0), "+$0/s")
			T.expectEqual(Format.perSecond(1234), "+$1.23K/s")
			T.expectEqual(Format.perSecond(-5), "+$0/s")
		end)
		T.it("arrondit au mètre inférieur, jamais négatif", function()
			T.expectEqual(Format.meters(123.8), "123 m")
			T.expectEqual(Format.meters(1500), "1,500 m")
			T.expectEqual(Format.meters(-3), "0 m")
		end)
	end)

	T.describe("Format.multiplier", function()
		T.it("écrit la CHANCE finale en X à deux décimales", function()
			T.expectEqual(Format.multiplier(1.36), "X1.36")
			T.expectEqual(Format.multiplier(2), "X2.00")
			T.expectEqual(Format.multiplier(12.346), "X12.35")
		end)
		T.it("ne descend jamais sous X1.00", function()
			T.expectEqual(Format.multiplier(0.5), "X1.00")
		end)
	end)

	T.describe("Format grands nombres (#94)", function()
		T.it("un suffixe par puissance de 1 000, jusqu'à Dc (10^33)", function()
			T.expectEqual(Format.short(1e12), "1T")
			T.expectEqual(Format.short(1.5e15), "1.5Qa")
			T.expectEqual(Format.short(3e17), "300Qa")
			T.expectEqual(Format.short(4.2e18), "4.2Qi")
			T.expectEqual(Format.short(7e21), "7Sx")
			T.expectEqual(Format.short(1e24), "1Sp")
			T.expectEqual(Format.short(1e33), "1Dc")
			T.expectEqual(Format.short(999e33), "999Dc")
		end)
		T.it("bornes : passe au suffixe suivant exactement à 1 000, jamais « 1000K »", function()
			T.expectEqual(Format.short(999), "999")
			T.expectEqual(Format.short(1000), "1K")
			T.expectEqual(Format.short(999999), "999K")
			T.expectEqual(Format.short(1e6), "1M")
			T.expectEqual(Format.short(999999999999), "999B")
			T.expectEqual(Format.short(1e15), "1Qa")
			T.expectEqual(Format.short(9.999e14), "999T")
		end)
		T.it("arrondis : pas d'erreur de virgule flottante (4 100 s'écrit 4.1K, pas 4.09K)", function()
			T.expectEqual(Format.short(4100), "4.1K")
			T.expectEqual(Format.short(8200), "8.2K")
			T.expectEqual(Format.short(5.7e6), "5.7M")
			T.expectEqual(Format.short(2.27e3), "2.27K")
			T.expectEqual(Format.short(1.37e3), "1.37K")
			T.expectEqual(Format.short(3.3e14), "330T")
		end)
		T.it("au-delà de Dc, notation scientifique ; NaN et infini lisibles", function()
			T.expectEqual(Format.short(1e36), "1e+36")
			T.expectEqual(Format.short(0 / 0), "0")
			T.expectEqual(Format.short(math.huge), "inf")
			T.expectEqual(Format.money(2.5e15), "$2.5Qa")
		end)
		T.it("séparateurs de milliers sans notation scientifique", function()
			T.expectEqual(Format.thousands(3e17), "300,000,000,000,000,000")
			T.expectEqual(Format.thousands(2e9), "2,000,000,000")
		end)
		T.it("cotes « 1 IN N » abrégées, au moins « 1 IN 1 »", function()
			T.expectEqual(Format.odds(3e17), "1 IN 300Qa")
			T.expectEqual(Format.odds(2270), "1 IN 2.27K")
			T.expectEqual(Format.odds(7), "1 IN 7")
			T.expectEqual(Format.odds(0.5), "1 IN 1")
		end)
		T.it("cote complète du secret : séparateurs jusqu'au milliard, abrégée au-delà", function()
			T.expectEqual(Format.fullOdds(2000000), "2,000,000")
			T.expectEqual(Format.fullOdds(999999999), "999,999,999")
			T.expectEqual(Format.fullOdds(5.5e13), "55T")
			T.expectEqual(Format.fullOdds(3e17), "300Qa")
		end)
		T.it("CHANCE finale : deux décimales, une dès 100, abrégée dès 1 000", function()
			T.expectEqual(Format.multiplier(99.5), "X99.50")
			T.expectEqual(Format.multiplier(123.4), "X123.4")
			T.expectEqual(Format.multiplier(5110), "X5.11K")
			T.expectEqual(Format.multiplier(2.5e6), "X2.5M")
		end)
		T.it(
			"chance des mannequins à lancer : décimales sous 10, entier jusqu'à 1 000, abrégée au-delà",
			function()
				T.expectEqual(Format.luck(1), "1.0x")
				T.expectEqual(Format.luck(1.25), "1.25x")
				T.expectEqual(Format.luck(6.5), "6.5x")
				T.expectEqual(Format.luck(10), "10x")
				T.expectEqual(Format.luck(135), "135x")
				T.expectEqual(Format.luck(2500), "2.5Kx")
			end
		)
	end)
end
