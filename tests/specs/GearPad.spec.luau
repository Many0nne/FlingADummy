-- Pad d'amélioration de l'équipement (#159) : texte et couleur du panneau selon l'équipement et l'argent.
return function(T, Loader)
	local loader = Loader.new()
	local GearPad = loader:require("src/shared/GearPad")
	local Training = loader:require("src/shared/Training")

	T.describe("GearPad.panel", function()
		T.it("annonce l'équipement suivant, son EXP par répétition et son prix", function()
			local panel = GearPad.panel(2, 0)
			T.expectEqual(panel.title, "NEXT: Iron Dummy")
			T.expectEqual(panel.gain, "+45 EXP / rep")
			T.expectEqual(panel.price, "$8K")
			T.expectEqual(panel.cost, 8000)
		end)
		T.it("vert si abordable, rouge sinon, neutre sur une place libre", function()
			T.expectEqual(GearPad.panel(2, 8000).tone, "Afford")
			T.expectEqual(GearPad.panel(2, 7999).tone, "Short")
			T.expectEqual(GearPad.panel(2, nil).tone, "Idle")
			T.expectEqual(GearPad.panel(1, 100).tone, "Afford")
		end)
		T.it("MAX au dernier palier, sans prix, quel que soit l'argent", function()
			local last = #Training.GEARS
			local panel = GearPad.panel(last, 1e15)
			T.expectEqual(panel.tone, "Max")
			T.expectEqual(panel.price, "MAX")
			T.expectEqual(panel.cost, nil)
			T.expectEqual(panel.gain, Training.GEARS[last].name)
			T.expectEqual(GearPad.panel(last - 1, 0).tone, "Short")
		end)
	end)
end
