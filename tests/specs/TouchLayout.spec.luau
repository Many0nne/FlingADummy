-- TouchLayout : échelle du HUD sur téléphone et tablette, zone tactile minimale, contrôles cachés quand on ne bouge pas.
return function(T, Loader)
	local TouchLayout = Loader.new():require("src/shared/TouchLayout")

	T.describe("TouchLayout.hudScale", function()
		T.it("ordinateur : inchangé (1280 × 720 → 1, bornes 0,5 et 1,3)", function()
			T.expectNear(TouchLayout.hudScale(1280, 720, false), 1)
			T.expectNear(TouchLayout.hudScale(844, 390, false), 390 / 720)
			T.expectNear(TouchLayout.hudScale(400, 200, false), 0.5)
			T.expectNear(TouchLayout.hudScale(3840, 2160, false), 1.3)
		end)
		T.it("téléphone en paysage (844 × 390) : 0,6, plus gros que sur ordinateur", function()
			local scale = TouchLayout.hudScale(844, 390, true)
			T.expectNear(scale, 0.6)
			T.expect(scale > TouchLayout.hudScale(844, 390, false), "pas plus gros sur téléphone")
		end)
		T.it(
			"la plus haute fenêtre (My Dummies, 560) tient en hauteur sur un petit téléphone (800 × 360)",
			function()
				local scale = TouchLayout.hudScale(800, 360, true)
				T.expect(360 / scale >= 560 + 40, "fenêtre plus haute que l'écran")
			end
		)
		T.it("tablette (iPad 1180 × 820) : 1", function()
			T.expectNear(TouchLayout.hudScale(1180, 820, true), 1)
		end)
	end)

	T.describe("TouchLayout.joystickReserve", function()
		T.it("petit écran (téléphone 844 × 390) : joystick de 70 px, zone de 105 × 142,5 px", function()
			local zone = TouchLayout.joystickReserve(844, 390)
			T.expectNear(zone.width, 105)
			T.expectNear(zone.height, 142.5)
		end)
		T.it("grand écran (tablette 1180 × 820) : joystick de 120 px, zone plus grande", function()
			local zone = TouchLayout.joystickReserve(1180, 820)
			T.expectNear(zone.width, 180)
			T.expectNear(zone.height, 230)
		end)
		T.it("la limite se juge sur le petit côté, quelle que soit l'orientation", function()
			local a = TouchLayout.joystickReserve(900, 500)
			local b = TouchLayout.joystickReserve(500, 900)
			T.expectNear(a.height, b.height)
			T.expect(TouchLayout.joystickReserve(900, 501).height > a.height, "au-delà de 500 px : joystick large")
		end)
	end)

	T.describe("TouchLayout.padRect", function()
		local function rect(x0, y0, x1, y1)
			return { x0 = x0, y0 = y0, x1 = x1, y1 = y1 }
		end
		T.it("porte un petit bouton seul à 44 px de côté, centré", function()
			local zone = TouchLayout.padRect(rect(100, 100, 126, 126), {})
			T.expectNear(zone.x1 - zone.x0, TouchLayout.MIN_TARGET)
			T.expectNear(zone.y1 - zone.y0, TouchLayout.MIN_TARGET)
			T.expectNear((zone.x0 + zone.x1) / 2, 113)
		end)
		T.it("ne réduit jamais un bouton déjà assez grand", function()
			local zone = TouchLayout.padRect(rect(0, 0, 80, 50), {})
			T.expectNear(zone.x0, 0)
			T.expectNear(zone.x1, 80)
			T.expectNear(zone.y1, 50)
		end)
		T.it("PLACE et SELL empilés (2 px d'écart) : chaque zone s'arrête au milieu, sans se recouvrir", function()
			local place, sell = rect(300, 110, 360, 128), rect(300, 130, 360, 148)
			local a = TouchLayout.padRect(place, { sell })
			local b = TouchLayout.padRect(sell, { place })
			T.expectNear(a.y1, 129)
			T.expectNear(b.y0, 129)
			T.expect(a.y0 < 110 and b.y1 > 148, "les côtés libres s'élargissent toujours")
		end)
		T.it("un voisin loin ne change rien ; des boutons qui se chevauchent déjà non plus", function()
			local own = rect(100, 100, 126, 126)
			local alone = TouchLayout.padRect(own, {})
			local far = TouchLayout.padRect(own, { rect(400, 100, 430, 126) })
			local overlapping = TouchLayout.padRect(own, { rect(110, 110, 140, 140) })
			T.expectNear(far.x1, alone.x1)
			T.expectNear(overlapping.x1, alone.x1)
		end)
	end)

	T.describe("TouchLayout.movementLocked", function()
		T.it("figé sur la bande, en vol, au résultat et pendant le tirage", function()
			T.expect(TouchLayout.movementLocked("Holding", "Ready", nil), "bande")
			T.expect(TouchLayout.movementLocked(nil, "Flying", nil), "vol")
			T.expect(TouchLayout.movementLocked(nil, "Result", nil), "résultat")
			T.expect(TouchLayout.movementLocked(nil, "Ready", "Reveal"), "tirage")
		end)
		T.it("libre au hub et à l'entraînement (le bouton de saut arrête la séance)", function()
			T.expect(not TouchLayout.movementLocked(nil, "Ready", nil), "hub")
			T.expect(not TouchLayout.movementLocked("Training", "Ready", nil), "entraînement")
			T.expect(not TouchLayout.movementLocked(nil, nil, nil), "avant la place")
		end)
	end)
end
