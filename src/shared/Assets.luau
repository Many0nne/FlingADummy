-- Cette méthode permet de donner l'URI d'un asset publié lorsque l'on le charge ; nil s'il n'est pas publié.
function Assets.uri(id: number?): string?
	if not id or id == 0 then
		return nil
	end
	return "rbxassetid://" .. id
end

return Assets
