local DummyModels = {}

export type Addon = {
	piece: string,
	size: Vector3,
	offset: Vector3,
	color: Color3,
	material: Enum.Material,
	transparency: number?,
	spin: { axis: Vector3, speed: number }?,
	bob: { amplitude: number, period: number }?,
}

export type Effect = {
	kind: string,
	preset: string?,
	piece: string,
	offset: Vector3,
	color: Color3,
	color2: Color3?,
	range: number?,
	brightness: number?,
	size: number?, -- multiplicateur de taille des particules (ou du faisceau)
	rate: number?, -- multiplicateur du debit des particules
	height: number?, -- faisceau : hauteur (studs, echelle 1)
	width: number?, -- faisceau : largeur (studs, echelle 1)
}

export type Look = {
	color: Color3,
	material: Enum.Material?,
	pieceColors: { [string]: Color3 }?,
	hidden: { string }?,
	accessories: { string },
	effects: { Effect }?,
}

